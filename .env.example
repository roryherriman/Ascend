# Ascend - example environment file.
#
# Copy this file to `.env` for local development convenience only.
# `.env` is gitignored and must never be committed.
#
# Ascend does NOT require this file to run. Warcraft Logs credentials and the
# Discord webhook are normally entered through the Settings page and stored
# securely via Windows Credential Manager (or an encrypted local fallback) -
# never in SQLite, YAML, or source code.
#
# These variables exist only so a developer can pre-fill Settings once during
# local testing instead of retyping credentials after every fresh database.
# If a value is already stored securely, these are ignored.

ASCEND_WCL_CLIENT_ID=your-client-id-here
ASCEND_WCL_CLIENT_SECRET=your-client-secret-here
ASCEND_DISCORD_WEBHOOK=https://discord.com/api/webhooks/your-webhook-here
